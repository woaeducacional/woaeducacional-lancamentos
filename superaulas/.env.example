# Rota oficial desejada para o projeto isolado. Definir ANTES do build na hospedagem.
# Deve coincidir com a rota configurada no proxy/roteador do domínio woatalk.com.br.
NEXT_PUBLIC_BASE_PATH=/BlackNovember/superaulas

# Cadastro público: URL e chave Publishable (ou anon legada), nunca secret/service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Com credenciais válidas, o cadastro está ativo. false permite pausá-lo explicitamente.
LEAD_CAPTURE_ENABLED=true
